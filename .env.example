# GitHub API token (optional but recommended)
# Without token: 60 requests/hour (unauthenticated)
# With token:    5,000 requests/hour
#
# Create one at: https://github.com/settings/tokens
# Only needs "public_repo" read scope (or no scope for public data)
#
# Copy this file to .env.local and fill in your token:
VITE_GITHUB_TOKEN=your_github_token_here

# Backend de solicitudes (yeyo-backapp). En producción: la URL de Vercel.
VITE_API_URL=http://localhost:8100
